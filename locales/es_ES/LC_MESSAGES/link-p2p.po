# Traducción de link-p2p al español
# Compilar: msgfmt --check -o link-p2p.mo link-p2p.po
# Los placeholders {0}, {1} son estilo format! de Rust; conserva su orden al traducir.
msgid ""
msgstr ""
"Project-Id-Version: link-p2p 0.1.0\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: es_ES\n"

# --- Ayuda de línea de comandos ---

msgid "Minimal TCP-over-QUIC forwarder on iroh"
msgstr "Reenviador TCP-over-QUIC mínimo sobre iroh"

msgid ""
"link-p2p exposes a local TCP service to a P2P network (or dials one) over a "
"direct, end-to-end encrypted QUIC connection. No TUN device, no "
"root/admin privileges — just a persistent EndpointId and a QUIC hop."
msgstr ""
"link-p2p expone un servicio TCP local a una red P2P (o se conecta a uno) mediante "
"una conexión QUIC directa cifrada de extremo a extremo. Sin dispositivo TUN, "
"sin privilegios de root/administrador: solo un EndpointId persistente y un salto QUIC."

msgid ""
"QUICK START:\n"
"    # On the machine you want to expose (e.g. its SSH server):\n"
"    link-p2p serve --forward 127.0.0.1:22\n"
"    # -> prints an EndpointId, share it with the other side\n"
"\n"
"    # On the connecting machine:\n"
"    link-p2p connect --to <EndpointId> --listen 127.0.0.1:2222\n"
"    ssh -p 2222 localhost\n"
"\n"
"SHELL COMPLETIONS:\n"
"    link-p2p completions fish > ~/.config/fish/completions/link-p2p.fish\n"
"    link-p2p completions bash > /etc/bash_completion.d/link-p2p\n"
"\n"
"See README.md for self-hosted --relay setup and benchmarking against "
"WireGuard/Tailscale."
msgstr ""
"INICIO RÁPIDO:\n"
"    # En la máquina que quieres exponer (p. ej. su servidor SSH):\n"
"    link-p2p serve --forward 127.0.0.1:22\n"
"    # -> imprime un EndpointId, compártelo con el otro lado\n"
"\n"
"    # En la máquina que se conecta:\n"
"    link-p2p connect --to <EndpointId> --listen 127.0.0.1:2222\n"
"    ssh -p 2222 localhost\n"
"\n"
"COMPLETADO DE SHELL:\n"
"    link-p2p completions fish > ~/.config/fish/completions/link-p2p.fish\n"
"    link-p2p completions bash > /etc/bash_completion.d/link-p2p\n"
"\n"
"Consulta README.md para el relay autoalojado (--relay) y la comparación con WireGuard/Tailscale."

msgid ""
"Path to store/load this node's persistent secret key. If it doesn't exist "
"yet, a new one is generated and saved here. Keep this stable if you want "
"your EndpointId to stay the same across restarts."
msgstr ""
"Ruta para guardar/cargar la clave secreta persistente de este nodo. Si no existe, "
"se genera una nueva y se guarda aquí. Mantén este archivo estable para que el "
"EndpointId no cambie entre reinicios."

msgid ""
"Use a custom relay server instead of n0's public one, e.g. http://127.0.0.1:3340 "
"(run `iroh-relay --dev` locally). With this set, address discovery is skipped "
"entirely: `connect` dials the peer directly through this relay, so no DNS/pkarr "
"lookup to iroh.link is needed. Useful for self-hosted relays and for "
"offline/local testing."
msgstr ""
"Usa un servidor relay propio en lugar del público de n0, p. ej. http://127.0.0.1:3340 "
"(ejecuta `iroh-relay --dev` localmente). Con esto se omite por completo el "
"descubrimiento de direcciones: `connect` dial al peer directamente a través de este "
"relay, sin necesidad de consultar DNS/pkarr a iroh.link. Útil para relays "
"autoalojados y pruebas offline/locales."

msgid "Expose a local TCP service to the P2P network."
msgstr "Expone un servicio TCP local a la red P2P."

msgid "Local address to forward incoming P2P streams to, e.g. 127.0.0.1:8080"
msgstr "Dirección local a la que reenviar los streams P2P entrantes, p. ej. 127.0.0.1:8080"

msgid "Dial a remote node and expose it as a local TCP listener."
msgstr "Marca a un nodo remoto y expónlo como un listener TCP local."

msgid "The remote node's EndpointId (printed by `serve` on startup)"
msgstr "El EndpointId del nodo remoto (impreso por `serve` al arrancar)"

msgid "Local address to listen on, e.g. 127.0.0.1:9090"
msgstr "Dirección local donde escuchar, p. ej. 127.0.0.1:9090"

msgid "Print a shell completion script to stdout."
msgstr "Imprime un script de completado de shell en stdout."

msgid ""
"Print a shell completion script to stdout.\n"
"\n"
"Redirect it to wherever your shell loads completions from, e.g. `link-p2p "
"completions fish > ~/.config/fish/completions/link-p2p.fish`."
msgstr ""
"Imprime un script de completado de shell en stdout.\n"
"\n"
"Redirígelo a donde tu shell cargue los completados, p. ej. `link-p2p completions "
"fish > ~/.config/fish/completions/link-p2p.fish`."

msgid "Which shell to generate a completion script for."
msgstr "Para qué shell generar el script de completado."

msgid "Control colored output: auto (colors on TTY only), always, or never."
msgstr "Controla la salida con colores: auto (colores solo en TTY), always o never."

msgid ""
"Maximum number of concurrent forwarded connections. 0 means unlimited. "
"Prevents resource exhaustion on endpoints exposed to the network."
msgstr ""
"Número máximo de conexiones reenviadas simultáneamente. 0 significa ilimitado. "
"Evita el agotamiento de recursos en endpoints expuestos a la red."

# --- Salida en tiempo de ejecución y registros ---

msgid "loading/creating persistent identity"
msgstr "cargando/creando identidad persistente"

msgid "identity file exists but has unexpected length {0} (expected 64 hex chars)"
msgstr "el archivo de identidad existe pero tiene una longitud inesperada: {0} (se esperaban 64 caracteres hexadecimales)"

msgid "identity file exists but contains non-hex characters"
msgstr "el archivo de identidad existe pero contiene caracteres no hexadecimales"

msgid "writing new identity to {0}"
msgstr "escribiendo nueva identidad en {0}"

msgid "setting permissions on {0}"
msgstr "estableciendo permisos en {0}"

msgid ""
"endpoint did not come online within {0}.\n"
"\n"
"The most likely cause: outgoing UDP is blocked by a firewall.\n"
"iroh/QUIC relies on UDP for both direct hole-punching and relay connections. "
"Try:\n"
"  nc -u -v -w3 8.8.8.8 53    # does UDP egress work at all?\n"
"  RUST_LOG=iroh=debug {1}     # see exactly where it's stuck"
msgstr ""
"el endpoint no se puso en línea en {0}.\n"
"\n"
"La causa más probable: el firewall bloquea el UDP saliente.\n"
"iroh/QUIC depende de UDP tanto para el hole-punching directo como para las conexiones "
"de relay. Prueba:\n"
"  nc -u -v -w3 8.8.8.8 53    # ¿funciona el envío de UDP?\n"
"  RUST_LOG=iroh=debug {1}     # mira exactamente dónde se atasca"

msgid "'{0}' is not a valid --relay URL"
msgstr "'{0}' no es una URL --relay válida"

msgid "binding endpoint"
msgstr "enlazando endpoint"

msgid "forwarding P2P connections to: {0}"
msgstr "reenviando conexiones P2P a: {0}"

msgid "your EndpointId (give this to peers running `connect --to`):"
msgstr "tu EndpointId (dáselo a los peers que ejecuten `connect --to`):"

msgid "Press Ctrl+C to stop."
msgstr "Pulsa Ctrl+C para detener."

msgid "shutting down..."
msgstr "apagando..."

msgid "connection opened"
msgstr "conexión abierta"

msgid "connection ended"
msgstr "conexión terminada"

msgid "connection closed"
msgstr "conexión cerrada"

msgid "stream error"
msgstr "error de stream"

msgid "connecting to local forward target {0}"
msgstr "conectando al destino de reenvío local {0}"

msgid "dialing {0}..."
msgstr "marcando {0}..."

msgid "connecting to remote endpoint"
msgstr "conectando al endpoint remoto"

msgid "connected. local TCP listener on {0} now forwards to the remote peer."
msgstr "conectado. El listener TCP local {0} ahora reenvía al peer remoto."

msgid "binding local listener on {0}"
msgstr "enlazando listener local en {0}"

msgid "'{0}' is not a valid EndpointId"
msgstr "'{0}' no es un EndpointId válido"

msgid "'{0}' is not a valid RelayUrl"
msgstr "'{0}' no es una RelayUrl válida"

msgid "finishing send stream"
msgstr "finalizando el stream de envío"

msgid "copying stream data"
msgstr "copiando datos del stream"

msgid "error"
msgstr "error"

# --- Modo proxy SOCKS5 ---

msgid "resolving {0}"
msgstr "resolviendo {0}"

msgid "no addresses for {0}"
msgstr "no hay direcciones para {0}"

msgid "domain name too long: {0} bytes"
msgstr "el nombre de dominio es demasiado largo: {0} bytes"

msgid "reading target header"
msgstr "leyendo la cabecera del destino"

msgid "non-utf8 domain in target header"
msgstr "dominio no UTF-8 en la cabecera del destino"

msgid "unknown address type {0} in target header"
msgstr "tipo de dirección desconocido {0} en la cabecera del destino"

msgid "reading SOCKS5 greeting"
msgstr "leyendo el saludo SOCKS5"

msgid "unsupported SOCKS version {0} (only SOCKS5 is supported)"
msgstr "versión SOCKS no compatible {0} (solo se admite SOCKS5)"

msgid "sending SOCKS5 method selection"
msgstr "enviando la selección de método SOCKS5"

msgid "reading SOCKS5 request"
msgstr "leyendo la petición SOCKS5"

msgid "bad SOCKS5 request version {0}"
msgstr "versión de petición SOCKS5 incorrecta {0}"

msgid "only CONNECT is supported (got command {0})"
msgstr "solo se admite CONNECT (se recibió el comando {0})"

msgid "non-utf8 domain in SOCKS5 request"
msgstr "dominio no UTF-8 en la petición SOCKS5"

msgid "unsupported address type {0}"
msgstr "tipo de dirección no compatible {0}"

msgid "sending SOCKS5 success reply"
msgstr "enviando la respuesta de éxito SOCKS5"

msgid "connecting to {0}"
msgstr "conectando a {0}"

msgid "proxy mode: dialing the target address from each stream's header"
msgstr "modo proxy: marcando a la dirección de destino de la cabecera de cada stream"

msgid ""
"Generic proxy mode: dial the address from each stream's header instead of a "
"fixed --forward target. Pairs with `connect --socks5-listen`."
msgstr ""
"Modo proxy genérico: marca a la dirección de la cabecera de cada stream en lugar "
"de un destino fijo --forward. Se combina con `connect --socks5-listen`."

msgid ""
"Speak SOCKS5 (no-auth, CONNECT only) on this local address; local clients "
"can then reach any destination through the remote `serve --proxy`."
msgstr ""
"Ofrece SOCKS5 (sin autenticación, solo CONNECT) en esta dirección local; los "
"clientes locales pueden alcanzar cualquier destino a través del `serve --proxy` remoto."

msgid "serve requires either --forward or --proxy"
msgstr "serve requiere --forward o --proxy"

msgid "connect requires either --listen or --socks5-listen"
msgstr "connect requiere --listen o --socks5-listen"
