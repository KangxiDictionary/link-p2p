msgstr "--to -（从 stdin 读取 EndpointId）仅在 Unix 构建中可用"

msgid "missing peer EndpointId (--to or LINK_P2P_TO)"
msgstr "缺少对端 EndpointId（--to 或 LINK_P2P_TO）"

msgid "--to - cannot be combined with --stdio (stdin conflict)"
msgstr "--to - 不能与 --stdio 同时使用（stdin 冲突）"

