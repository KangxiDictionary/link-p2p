# link-p2p 简体中文翻译
# 用 msgfmt 编译为 .mo：msgfmt --check -o link-p2p.mo link-p2p.po
# 占位符 {0}、{1} 等为 Rust format! 风格，翻译时须保留且顺序一致。
msgid ""
msgstr ""
"Project-Id-Version: link-p2p 0.1.0\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: zh_CN\n"

# --- 命令行 help ---

msgid "Minimal TCP-over-QUIC forwarder on iroh"
msgstr "基于 iroh 的最小 TCP-over-QUIC 转发器"

msgid ""
"link-p2p exposes a local TCP service to a P2P network (or dials one) over a "
"direct, end-to-end encrypted QUIC connection. No TUN device, no "
"root/admin privileges — just a persistent EndpointId and a QUIC hop."
msgstr ""
"link-p2p 通过一条端到端加密的直连 QUIC 连接，把本地 TCP 服务暴露到 P2P "
"网络（或拨号接入对方的服务）。无需 TUN 设备，无需 root/管理员权限——"
"只需要一个持久的 EndpointId 和一跳 QUIC。"

msgid ""
"QUICK START:\n"
"    # On the machine you want to expose (e.g. its SSH server):\n"
"    link-p2p serve --forward 127.0.0.1:22\n"
"    # -> prints an EndpointId, share it with the other side\n"
"\n"
"    # On the connecting machine:\n"
"    link-p2p connect --to <EndpointId> --listen 127.0.0.1:2222\n"
"    ssh -p 2222 localhost\n"
"\n"
"SHELL COMPLETIONS:\n"
"    link-p2p completions fish > ~/.config/fish/completions/link-p2p.fish\n"
"    link-p2p completions bash > /etc/bash_completion.d/link-p2p\n"
"\n"
"See README.md for self-hosted --relay setup and benchmarking against "
"WireGuard/Tailscale."
msgstr ""
"快速开始：\n"
"    # 在要暴露服务的机器上（例如它的 SSH 服务器）：\n"
"    link-p2p serve --forward 127.0.0.1:22\n"
"    # -> 打印一个 EndpointId，把它分享给对端\n"
"\n"
"    # 在发起连接的机器上：\n"
"    link-p2p connect --to <EndpointId> --listen 127.0.0.1:2222\n"
"    ssh -p 2222 localhost\n"
"\n"
"Shell 补全：\n"
"    link-p2p completions fish > ~/.config/fish/completions/link-p2p.fish\n"
"    link-p2p completions bash > /etc/bash_completion.d/link-p2p\n"
"\n"
"自建 --relay 配置以及与 WireGuard/Tailscale 的基准对比，见 README.md。"

msgid ""
"Path to store/load this node's persistent secret key. If it doesn't exist "
"yet, a new one is generated and saved here. Keep this stable if you want "
"your EndpointId to stay the same across restarts."
msgstr ""
"用于存储/加载本节点持久密钥的路径。若文件不存在则生成新密钥并保存到此处。"
"保持该文件稳定，EndpointId 即可在重启后保持不变。"

msgid ""
"Use a custom relay server instead of n0's public one, e.g. http://127.0.0.1:3340 "
"(run `iroh-relay --dev` locally). With this set, address discovery is skipped "
"entirely: `connect` dials the peer directly through this relay, so no DNS/pkarr "
"lookup to iroh.link is needed. Useful for self-hosted relays and for "
"offline/local testing."
msgstr ""
"使用自定义 relay 服务器替代 n0 公共 relay，例如 http://127.0.0.1:3340 "
"（本地可用 `iroh-relay --dev` 启动）。设置后完全跳过地址发现：`connect` "
"直接通过该 relay 拨号对端，无需查询 iroh.link 的 DNS/pkarr。适用于自建 "
"relay 与离线/本地测试。"

msgid "Expose a local TCP service to the P2P network."
msgstr "将本地 TCP 服务暴露到 P2P 网络。"

msgid "Local address to forward incoming P2P streams to, e.g. 127.0.0.1:8080"
msgstr "转发 P2P 入站流的目标本地地址，例如 127.0.0.1:8080"

msgid "Dial a remote node and expose it as a local TCP listener."
msgstr "拨号连接远端节点，并将其暴露为本地 TCP 监听端口。"

msgid "The remote node's EndpointId (printed by `serve` on startup)"
msgstr "远端节点的 EndpointId（`serve` 启动时会打印）"

msgid "Local address to listen on, e.g. 127.0.0.1:9090"
msgstr "本地监听地址，例如 127.0.0.1:9090"

msgid "Print a shell completion script to stdout."
msgstr "向标准输出打印 shell 补全脚本。"

msgid ""
"Print a shell completion script to stdout.\n"
"\n"
"Redirect it to wherever your shell loads completions from, e.g. `link-p2p "
"completions fish > ~/.config/fish/completions/link-p2p.fish`."
msgstr ""
"向标准输出打印 shell 补全脚本。\n"
"\n"
"将其重定向到你的 shell 加载补全的位置，例如 `link-p2p completions fish > "
"~/.config/fish/completions/link-p2p.fish`。"

msgid "Which shell to generate a completion script for."
msgstr "为哪个 shell 生成补全脚本。"

msgid "Control colored output: auto (colors on TTY only), always, or never."
msgstr "控制彩色输出：auto（仅在终端显示颜色）、always 或 never。"

msgid ""
"Maximum number of concurrent forwarded connections. 0 means unlimited. "
"Prevents resource exhaustion on endpoints exposed to the network."
msgstr ""
"同时转发的最大连接数。0 表示不限制。防止暴露在网络上的端点资源耗尽。"

# --- 运行时输出与日志 ---

msgid "loading/creating persistent identity"
msgstr "加载/创建持久身份"

msgid "identity file exists but has unexpected length {0} (expected 64 hex chars)"
msgstr "身份文件存在但长度异常：{0}（应为 64 个十六进制字符）"

msgid "identity file exists but contains non-hex characters"
msgstr "身份文件存在但包含非十六进制字符"

msgid "writing new identity to {0}"
msgstr "写入新身份到 {0}"

msgid "setting permissions on {0}"
msgstr "设置 {0} 的权限"

msgid ""
"endpoint did not come online within {0}.\n"
"\n"
"The most likely cause: outgoing UDP is blocked by a firewall.\n"
"iroh/QUIC relies on UDP for both direct hole-punching and\n"
"relay connections. Try:\n"
"nc -u -v -w3 8.8.8.8 53    # does UDP egress work at all?\n"
"RUST_LOG=iroh=debug {1}     # see exactly where it's stuck"
msgstr ""
"端点在 {0} 内未能上线。\n"
"\n"
"最常见原因：出站 UDP 被防火墙拦截。\n"
"iroh/QUIC 依赖 UDP 进行直连打洞与 relay 连接。可尝试：\n"
"  nc -u -v -w3 8.8.8.8 53    # 测试 UDP 出站是否正常\n"
"  RUST_LOG=iroh=debug {1}     # 查看具体卡在哪一步"

msgid "'{0}' is not a valid --relay URL"
msgstr "'{0}' 不是合法的 --relay URL"

msgid "binding endpoint"
msgstr "绑定端点"

msgid "forwarding P2P connections to: {0}"
msgstr "P2P 连接将转发到：{0}"

msgid "your EndpointId (give this to peers running `connect --to`):"
msgstr "你的 EndpointId（把它给运行 `connect --to` 的对端）："

msgid "Press Ctrl+C to stop."
msgstr "按 Ctrl+C 停止。"

msgid "shutting down..."
msgstr "正在关闭……"

msgid "connection opened"
msgstr "连接已建立"

msgid "connection ended"
msgstr "连接已结束"

msgid "connection closed"
msgstr "连接已关闭"

msgid "stream error"
msgstr "流错误"

msgid "dialing {0}..."
msgstr "正在拨号 {0}……"

msgid "connecting to remote endpoint"
msgstr "正在连接远端端点"

msgid "connected. local TCP listener on {0} now forwards to the remote peer."
msgstr "已连接。本地 TCP 监听 {0} 现在转发到远端节点。"

msgid "binding local listener on {0}"
msgstr "绑定本地监听 {0}"

msgid "'{0}' is not a valid EndpointId"
msgstr "'{0}' 不是合法的 EndpointId"

msgid "'{0}' is not a valid RelayUrl"
msgstr "'{0}' 不是合法的 RelayUrl"

msgid "finishing send stream"
msgstr "结束发送流"

msgid "copying stream data"
msgstr "复制流数据"

msgid "error"
msgstr "错误"

# --- SOCKS5 代理模式 ---

msgid "resolving {0}"
msgstr "正在解析 {0}"

msgid "no addresses for {0}"
msgstr "{0} 没有可用地址"

msgid "domain name too long: {0} bytes"
msgstr "域名过长：{0} 字节"

msgid "reading target header"
msgstr "读取目标地址头部"

msgid "non-utf8 domain in target header"
msgstr "目标地址头部包含非 UTF-8 域名"

msgid "unknown address type {0} in target header"
msgstr "目标地址头部存在未知地址类型 {0}"

msgid "reading SOCKS5 greeting"
msgstr "读取 SOCKS5 握手消息"

msgid "unsupported SOCKS version {0} (only SOCKS5 is supported)"
msgstr "不支持的 SOCKS 版本 {0}（仅支持 SOCKS5）"

msgid "sending SOCKS5 method selection"
msgstr "发送 SOCKS5 认证方式协商"

msgid "reading SOCKS5 request"
msgstr "读取 SOCKS5 请求"

msgid "bad SOCKS5 request version {0}"
msgstr "错误的 SOCKS5 请求版本 {0}"

msgid "only CONNECT is supported (got command {0})"
msgstr "仅支持 CONNECT 命令（收到命令 {0}）"

msgid "non-utf8 domain in SOCKS5 request"
msgstr "SOCKS5 请求包含非 UTF-8 域名"

msgid "unsupported address type {0}"
msgstr "不支持的地址类型 {0}"

msgid "sending SOCKS5 success reply"
msgstr "发送 SOCKS5 成功响应"

msgid "connecting to {0}"
msgstr "正在连接 {0}"

msgid "proxy mode: dialing the target address from each stream's header"
msgstr "代理模式：按每个流头部中的目标地址拨号"

msgid ""
"Generic proxy mode: dial the address from each stream's header instead of a "
"fixed --forward target. Pairs with `connect --socks5-listen`."
msgstr ""
"通用代理模式：按每个流头部中的目标地址拨号，而非固定的 --forward 目标。"
"与 `connect --socks5-listen` 配合使用。"

msgid ""
"Speak SOCKS5 (no-auth, CONNECT only) on this local address; local clients "
"can then reach any destination through the remote `serve --proxy`."
msgstr ""
"在此本地地址上提供 SOCKS5 服务（无认证，仅 CONNECT）；本地客户端可通过"
"远端的 `serve --proxy` 访问任意目的地。"

msgid "serve requires either --forward or --proxy"
msgstr "serve 需要 --forward 或 --proxy 其中之一"

msgid "connect requires either --listen or --socks5-listen"
msgstr "connect 需要 --listen 或 --socks5-listen 其中之一"

# --- TUN 模式 ---

msgid "Make two machines reachable at the IP layer over QUIC datagrams."
msgstr "通过 QUIC datagram 让两台机器在 IP 层互相可达。"

msgid ""
"Make two machines reachable at the IP layer over QUIC datagrams.\n"
"\n"
"Creates a TUN interface (needs root / CAP_NET_ADMIN) and routes the peer's "
"virtual IP through it. Unlike `serve`/`connect`, which forward one TCP "
"port, this bridges the whole machine: TCP, UDP and ICMP all work on the "
"peer's virtual IP, with no per-port setup. Point-to-point only in v1 — see "
"docs/tun-design.md."
msgstr ""
"通过 QUIC datagram 让两台机器在 IP 层互相可达。\n"
"\n"
"创建一个 TUN 接口（需要 root / CAP_NET_ADMIN），并把对端的虚拟 IP 路由到它。"
"与只转发单个 TCP 端口的 `serve`/`connect` 不同，本模式桥接整台机器：TCP、"
"UDP、ICMP 都能通过对端虚拟 IP 访问，无需逐个端口配置。v1 仅支持点对点——"
"见 docs/tun-design.md。"

msgid "Exposed side: accept a peer and bridge this machine to it at the IP layer."
msgstr "被访问侧：接受对端连接，并在 IP 层桥接本机与对端。"

msgid ""
"Exposed side: accept a peer and bridge this machine to it at the IP layer. "
"Prints this node's virtual IP and EndpointId, then forwards all packets to "
"the first peer that dials."
msgstr ""
"被访问侧：接受对端连接，并在 IP 层桥接本机与对端。打印本节点的虚拟 IP 与 "
"EndpointId，然后向第一个拨号的对端转发所有数据包。"

msgid "Dial a peer and bridge this machine to it at the IP layer."
msgstr "拨号连接对端，并在 IP 层桥接本机与对端。"

msgid ""
"Override this node's virtual IP (default: derived from its EndpointId, "
"inside 100.64.0.0/10)."
msgstr ""
"覆盖本节点的虚拟 IP（默认：由其 EndpointId 派生，位于 100.64.0.0/10 段内）。"

msgid ""
"Upper bound for the TUN interface MTU (default 1280). The final MTU is "
"min(this, the negotiated QUIC datagram max); values above 1280 are refused."
msgstr ""
"TUN 接口 MTU 的上限（默认 1280）。最终 MTU 为 min(该值, 协商出的 QUIC "
"datagram 上限)；超过 1280 的值会被拒绝。"

msgid "The remote node's EndpointId (printed by `tun serve` on startup)"
msgstr "远端节点的 EndpointId（`tun serve` 启动时会打印）"

msgid ""
"--mtu must be at most 1280 (got {0}); higher values would fragment the outer "
"QUIC datagrams"
msgstr ""
"--mtu 最大只能为 1280（收到 {0}）；更大的值会导致外层 QUIC datagram 分片"

msgid ""
"the peer or path does not support QUIC datagrams; TUN mode cannot work over "
"this connection.\n"
"Refusing to start rather than silently falling back to a stream transport."
msgstr ""
"对端或路径不支持 QUIC datagram；此连接上无法使用 TUN 模式。\n"
"拒绝启动，而不是静默回退到 stream 传输。"

msgid "running `ip {0}`"
msgstr "正在执行 `ip {0}`"

msgid "command `ip {0}` failed: {1}"
msgstr "命令 `ip {0}` 执行失败：{1}"

msgid "checking local interfaces for the virtual IP"
msgstr "检查本地接口是否占用该虚拟 IP"

msgid ""
"virtual IP {0} is already assigned to a local interface.\n"
"Pick a different one with --tun-ip."
msgstr ""
"虚拟 IP {0} 已被本地某个接口占用。\n"
"请用 --tun-ip 指定其他地址。"

msgid "TUN mode currently supports Linux only"
msgstr "TUN 模式目前仅支持 Linux"

msgid "creating TUN device (needs root / CAP_NET_ADMIN)"
msgstr "创建 TUN 设备（需要 root / CAP_NET_ADMIN）"

msgid "reading TUN interface name"
msgstr "读取 TUN 接口名称"

msgid "reading packet from TUN device"
msgstr "从 TUN 设备读取数据包"

msgid "sending datagram to peer failed"
msgstr "向对端发送 datagram 失败"

msgid "writing packet to TUN device"
msgstr "向 TUN 设备写入数据包"

msgid "peer disconnected"
msgstr "对端已断开"

msgid "your virtual IP (the peer reaches you here):"
msgstr "你的虚拟 IP（对端通过它访问本机）："

msgid "your EndpointId (give this to peers running `tun connect --to`):"
msgstr "你的 EndpointId（把它给运行 `tun connect --to` 的对端）："

msgid "TUN session established"
msgstr "TUN 会话已建立"

msgid "rejecting malformed incoming connection"
msgstr "拒绝格式异常的入站连接"

msgid "completing connection handshake"
msgstr "完成连接握手"

msgid "endpoint closed"
msgstr "端点已关闭"

msgid "TUN session error"
msgstr "TUN 会话错误"

msgid "connected. your virtual IP: {0}"
msgstr "已连接。你的虚拟 IP：{0}"

msgid "peer {0} is reachable at {1}"
msgstr "对端 {0} 在 {1} 可达"

msgid "peer disconnected, exiting..."
msgstr "对端已断开，正在退出……"
