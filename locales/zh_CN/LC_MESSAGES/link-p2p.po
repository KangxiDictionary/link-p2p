msgid "sending SOCKS5 method selection"
msgstr "发送 SOCKS5 认证方式协商"

msgid "reading SOCKS5 request"
msgstr "读取 SOCKS5 请求"

msgid "bad SOCKS5 request version {0}"
msgstr "错误的 SOCKS5 请求版本 {0}"

